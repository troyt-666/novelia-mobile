# Copy this file to android/key.properties, which is ignored by Git.
# Local builds read these fields. GitHub Actions uses repository secrets
# JFZREADER_ANDROID_STORE_BASE64 and JFZREADER_ANDROID_{STORE_PASSWORD,
# KEY_ALIAS, KEY_PASSWORD} instead of this file.
storeFile=/absolute/private/path/jfzreader-release.jks
storePassword=replace-interactively
keyAlias=jfzreader
keyPassword=replace-interactively
